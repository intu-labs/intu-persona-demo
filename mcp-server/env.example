# Port for the MCP Server
PORT=3000

# Set to 'false' for production; 'true' for development
DEBUG=true

# Logging level
# Options: error, warn, info, debug
LOG_LEVEL=debug

# ===============================================================================
# ESSETNIAL CONFIG OPTIONS (Start)
# ===============================================================================

JSON_RPC=
PINATA_JWT=
RUNPOD_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo


# ===============================================================================
# ESSETNIAL CONFIG OPTIONS (End)
# ===============================================================================

# ===============================================================================
# MINIO OBJECT STORAGE CONFIGURATION
# ===============================================================================

# MinIO server endpoint (without http://)
MINIO_ENDPOINT=localhost

# MinIO server port
MINIO_PORT=9000

# Use SSL for MinIO connection (true/false)
MINIO_USE_SSL=false

# MinIO access credentials
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# MinIO bucket name for storing persona images
MINIO_BUCKET=persona-images

# ===============================================================================
# LLM CONFIGURATION FOR PERSONA GENERATION
# ===============================================================================

# Provider auto-detection:
# - If OPENAI_API_KEY is set, will use OpenAI
# - Otherwise defaults to Ollama (local)

# OpenAI Configuration (if using OpenAI)
# Set this to automatically switch to OpenAI provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Ollama Configuration (if using Ollama - default)
# Ollama server URL for LLM operations used by MCP tools
# This is used for persona generation, name generation, and accessory selection
OLLAMA_URL=http://localhost:11434

# Ollama model name (must match exactly what's available in your Ollama instance)
# Check available models with: ollama list
# Common options: gemma2:2b, gemma2:9b, gemma3:12b, llama3.1:8b, qwen2.5:7b
OLLAMA_MODEL=gemma3:12b

# ===============================================================================
# COMFYUI IMAGE GENERATION CONFIGURATION
# ===============================================================================

# ComfyUI server URL for image generation
COMFYUI_URL=http://localhost:8188

# ComfyUI workflows directory (relative to project root)
COMFYUI_WORKFLOWS_DIR=../comfyui-custom/Workflows

# Default workflow file for profile image generation
COMFYUI_DEFAULT_WORKFLOW=profile-picture-simple.json

# ===============================================================================
# PERSONA GENERATION SETTINGS
# ===============================================================================

# Maximum number of rerolls allowed per persona (1-5)
MAX_REROLLS=3

# Enable persona caching in MongoDB (true/false)
ENABLE_PERSONA_CACHE=true

# Cache expiration time in seconds (86400 = 24 hours)
CACHE_EXPIRATION=86400

# ===============================================================================
# IMAGE GENERATION SETTINGS
# ===============================================================================

# Default image dimensions for profile pictures (3:2 aspect ratio)
DEFAULT_IMAGE_WIDTH=512
DEFAULT_IMAGE_HEIGHT=768

# Number of image variations to generate per persona
IMAGE_VARIATIONS=4

# Image quality settings (1-100, higher = better quality but larger files)
IMAGE_QUALITY=90

# ===============================================================================
# API RATE LIMITING
# ===============================================================================

# Enable rate limiting (true/false)
ENABLE_RATE_LIMITING=true

# Requests per minute per IP
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Rate limiting window in minutes
RATE_LIMIT_WINDOW_MINUTES=1

# ===============================================================================
# SECURITY SETTINGS
# ===============================================================================

# JWT secret for session management (generate a secure random string)
# Example: openssl rand -hex 32
JWT_SECRET=your-super-secure-jwt-secret-key-here

# API key for external service authentication (optional)
API_KEY=

# Enable HTTPS redirect in production (true/false)
FORCE_HTTPS=false

# ===============================================================================
# DEVELOPMENT SETTINGS
# ===============================================================================

# Enable hot reload in development (true/false)
HOT_RELOAD=true

# Enable detailed error responses (disable in production)
DETAILED_ERRORS=true

# Enable request/response logging (true/false)
LOG_REQUESTS=true

# ===============================================================================
# PRODUCTION OPTIMIZATION
# ===============================================================================

# Enable response compression (true/false)
ENABLE_COMPRESSION=true

# Enable response caching (true/false)
ENABLE_CACHING=true

# Cache TTL in seconds
CACHE_TTL=300

# ===============================================================================
# MONITORING AND HEALTH CHECKS
# ===============================================================================

# Enable health check endpoint (true/false)
ENABLE_HEALTH_CHECK=true

# Health check interval in seconds
HEALTH_CHECK_INTERVAL=30

# Enable metrics collection (true/false)
ENABLE_METRICS=true

# ===============================================================================
# BACKUP AND MAINTENANCE
# ===============================================================================

# Enable automatic image cleanup (true/false)
ENABLE_AUTO_CLEANUP=true

# Image cleanup interval in hours
CLEANUP_INTERVAL_HOURS=24

# Maximum image age before cleanup (hours)
MAX_IMAGE_AGE_HOURS=72 