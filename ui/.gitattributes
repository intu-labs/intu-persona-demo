# Auto detect text files and perform LF normalization
* text=auto

# Force specific files to be treated as text
*.ts text
*.tsx text
*.js text
*.jsx text
*.json text
*.md text
*.css text
*.scss text
*.html text

# Force specific files to be treated as binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.flv binary
*.fla binary
*.swf binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.eot binary
*.woff binary
*.pyc binary
*.pdf binary

# Enforce case sensitivity
*.ts case-sensitive
*.tsx case-sensitive
*.js case-sensitive
*.jsx case-sensitive 