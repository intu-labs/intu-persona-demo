# MCP Server Connection
MCP_SERVER_URL=http://127.0.0.1:3000/mcp
#MCP_SERVER_URL=http://localhost:3001


# Port for the Orchestrator Server
PORT=3005

# LLM Settings
# Supported providers: 'ollama', 'anthropic', 'openai'
# Provider auto-detection:
# - If OPENAI_API_KEY is set, will use OpenAI
# - If ANTHROPIC_API_KEY is set, will use Anthropic  
# - Otherwise defaults to Ollama
#LLM_PROVIDER=ollama
#LLM_MODEL=gemma3
#LLM_MODEL=llama3

LLM_API_KEY=
LLM_API_URL=

# OpenAI Configuration (if using OpenAI)
# Set this to automatically switch to OpenAI provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Anthropic Configuration (if using Anthropic - not yet implemented)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Ollama-specific settings (if using Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3 

